<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univartois.butinfo.ihm.ApplicationBanque"
            prefWidth="900" prefHeight="560"
            stylesheets="@style.css"
            styleClass="auth-shell">

    <VBox alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox spacing="18" maxWidth="420" alignment="CENTER" styleClass="auth-card">
            <Button text="Retour au menu principal" onAction="#onClickButtonMainPage" styleClass="button-secondary"/>
            <Label fx:id="label" text="Connexion" styleClass="auth-title"/>
            <TextField fx:id="text" promptText="Identifiant"/>
            <PasswordField fx:id="passwd" promptText="Mot de passe"/>
            <Button fx:id="connexion" text="Se connecter" onAction="#identifiant" maxWidth="260"/>
        </VBox>
    </VBox>
</AnchorPane>