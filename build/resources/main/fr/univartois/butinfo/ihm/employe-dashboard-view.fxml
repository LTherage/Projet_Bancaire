<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univartois.butinfo.ihm.EmployeDashboardController"
      spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20;">
    <Label text="Dashboard Employé" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Compte client :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="compteClientCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Montant :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="montantField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Déposer" onAction="#deposerArgent"/>
        <Button text="Retirer" onAction="#retirerArgent"/>
        <Button text="Retour au menu" onAction="#retourMenu"/>
    </HBox>
</VBox>
