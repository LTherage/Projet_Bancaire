<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univartois.butinfo.ihm.ApplicationBanque"
            prefWidth="900" prefHeight="560"
            stylesheets="@style.css"
            styleClass="auth-shell">

    <VBox alignment="CENTER" spacing="18" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox alignment="CENTER" spacing="16" maxWidth="420" styleClass="auth-card">
            <Label text="Bienvenue" styleClass="auth-title"/>
            <Label text="Votre espace bancaire sécurisé" styleClass="auth-subtitle"/>

            <Button text="Se connecter" fx:id="connexion" onAction="#seConnecter" maxWidth="260"/>
            <Button text="Créer un compte" onAction="#creerCompte" maxWidth="260" styleClass="button-secondary"/>
        </VBox>
    </VBox>
</AnchorPane>
